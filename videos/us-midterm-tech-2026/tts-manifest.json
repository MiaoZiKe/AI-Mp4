      "voice": "Charon",
      "model": "gemini-3.8-flash-lite-tts"
    },
    {
      "id": "markets",
      "file": "audio/us-midterm-tech-2026/12-markets.wav",
      "sec": 5.782,
      "text": "選後首日美股大盤漲、晶片股跌，那斯達克進入修正，台股也重挫。",
      "hash": "040592cf78d9",
      "voice": "Charon",
      "model": "gemini-3.8-flash-lite-tts"
    },
    {
      "id": "taiwan-tech",
      "file": "audio/us-midterm-tech-2026/13-taiwan-tech.wav",
