    },
    {
      "id": "p6_s03",
      "file": "audio/voice-batch-tmp/54-p6_s03.wav",
      "sec": 4.2,
      "text": "結果品名、價格、過敏提示都對，一道也沒錯。",
      "hash": "584c95f504cc-fd65c16ade",
      "voice": "Sulafat",
