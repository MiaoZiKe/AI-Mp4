      "headSec": 0.04,
      "tailSec": 5.95,
      "confidence": 0.959,
      "minScore": 0.48,
      "gapAfter": 0.26
    },
    {
      "id": "p6_s08",
      "file": "audio/voice-batch-tmp/59-p6_s08.wav",
      "sec": 5.31,
      "text": "不過我只用一張自製菜單、一個模型，真的店家的菜單，還不知道。",
      "hash": "fee2aa2aa458-fd65c16ade",
      "voice": "Sulafat",
      "model": "gemini-2.5-flash-preview-tts",
