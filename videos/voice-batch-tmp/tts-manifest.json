      "confidence": 0.958,
      "minScore": 0.595,
      "gapAfter": 0.22
    },
    {
      "id": "p6_s07",
      "file": "audio/voice-batch-tmp/58-p6_s07.wav",
      "sec": 5.99,
      "text": "但洋蔥、叉燒、蔥花，菜單根本沒印，是它補的，沒有一道標不確定。",
      "hash": "b406a400ab29-fd65c16ade",
      "voice": "Sulafat",
      "model": "gemini-2.5-flash-preview-tts",
      "takeStart": 238.7,
