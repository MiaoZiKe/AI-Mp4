    },
    {
      "id": "p4_s08",
      "file": "audio/voice-batch-tmp/39-p4_s08.wav",
      "sec": 4.29,
      "text": "不過只出一題、各問兩次，誰比較強，還不知道。",
      "hash": "66245e0ef0cd-fd65c16ade",
      "voice": "Sulafat",
