{
 "slug": "voice-batch-tmp",
 "voice": {
  "voiceName": "Sulafat",
  "mode": "take",
  "languageCode": "cmn-TW",
  "profile": "ai-report-v5"
 },
 "scenes": [
  {
   "id": "p1_s01",
   "narration": "手機跳出看不懂的畫面，截圖丟給 AI，直接問它。",
   "para": 101
  },
  {
   "id": "p1_s02",
   "narration": "第一步，截圖，把有紅字的那一塊截進去。",
   "para": 101
  },
  {
   "id": "p1_s03",
   "narration": "第二步，問它：這是什麼，我該怎麼辦，請一步一步說。",
   "para": 101
  },
  {
   "id": "p1_s04",
   "narration": "它讀出只剩 0.3 GB、至少要 1 GB，叫我按「管理儲存空間」。",
   "para": 101
  },
  {
   "id": "p1_s05",
   "narration": "第三步，照畫面對一次數字，我對過，沒讀錯。",
   "para": 101
  },
  {
   "id": "p1_s06",
   "narration": "圖縮到很小，數字還是讀對；但只截一半，沒截到紅字，它就開始猜。",
   "para": 101
  },
  {
   "id": "p1_s07",
   "narration": "兩次都先猜沒連 Wi-Fi，其實真正的原因是空間不足。",
   "para": 101
  },
  {
   "id": "p1_s08",
   "narration": "不過我只試一張自製畫面、一個模型，別的畫面還不知道。",
   "para": 101
  },
  {
   "id": "p1_s09",
   "narration": "所以三步：截圖截完整、一步一步問、照畫面核對。",
   "para": 101
  },
  {
   "id": "p1_s10",
   "narration": "留言「截圖」，拿這句提問提示詞。",
   "para": 101
  },
  {
   "id": "p2_s01",
   "narration": "一份四頁的講義，叫 AI 只照原文回答，每句附頁碼。",
   "para": 201
  },
  {
   "id": "p2_s02",
   "narration": "我只多加一句：只根據原文回答，每句標頁碼。",
   "para": 201
  },
  {
   "id": "p2_s03",
   "narration": "沒加這句，答案也對，但沒說哪一頁；加了，每句都有頁碼。",
   "para": 201
  },
  {
   "id": "p2_s04",
   "narration": "沒有頁碼，我得自己翻四頁去找。",
   "para": 201
  },
  {
   "id": "p2_s05",
   "narration": "有頁碼，我只翻被標的位置，五個頁碼全對。",
   "para": 201
  },
  {
   "id": "p2_s06",
   "narration": "像第三頁，罰款和賠償，原文就在那裡。",
   "para": 201
  },
  {
   "id": "p2_s07",
   "narration": "影印這題，文件根本沒寫，兩種版本都老實說沒寫。",
   "para": 201
  },
  {
   "id": "p2_s08",
   "narration": "不過這份只有四頁，更長的文件會不會編，還不知道。",
   "para": 201
  },
  {
   "id": "p2_s09",
   "narration": "所以做法：貼文件、規定附頁碼、翻到那頁核對。",
   "para": 201
  },
  {
   "id": "p2_s10",
   "narration": "留言「頁碼」，拿這句規定的提示詞。",
   "para": 201
  },
  {
   "id": "p3_s01",
   "narration": "一分鐘內，叫 AI 寫三條 Excel 公式，還要算得對。",
   "para": 301
  },
  {
   "id": "p3_s02",
   "narration": "我先說表格長怎樣，再一條一條問。",
   "para": 301
  },
  {
   "id": "p3_s03",
   "narration": "第一條，北區、大於五千的加總，它給了這條公式。",
   "para": 301
  },
  {
   "id": "p3_s04",
   "narration": "三條公式，一共用了八點五秒。",
   "para": 301
  },
  {
   "id": "p3_s05",
   "narration": "我用 LibreOffice 真的算一遍，兩條對，一條算出零。",
   "para": 301
  },
  {
   "id": "p3_s06",
   "narration": "第二條日期用斜線，在 LibreOffice 認不出，改橫線就行。",
   "para": 301
  },
  {
   "id": "p3_s07",
   "narration": "我把結果告訴它：算出零，請修。",
   "para": 301
  },
  {
   "id": "p3_s08",
   "narration": "修完算出七萬五千三百零一，三條全對。",
   "para": 301
  },
  {
   "id": "p3_s09",
   "narration": "不過這是 LibreOffice 驗算，真的 Excel 還不知道。",
   "para": 301
  },
  {
   "id": "p3_s10",
   "narration": "所以做法：講清楚欄位、貼上驗算、算錯就把結果告訴它。",
   "para": 301
  },
  {
   "id": "p3_s11",
   "narration": "留言「公式」，拿這三題的提示詞。",
   "para": 301
  },
  {
   "id": "p4_s01",
   "narration": "同一題整理帳目，我問兩個 AI，看誰算對。",
   "para": 401
  },
  {
   "id": "p4_s02",
   "narration": "十二行流水帳，藏了重複貼上、中文數字和退款三個陷阱。",
   "para": 401
  },
  {
   "id": "p4_s03",
   "narration": "看答案之前，我先算好標準答案，寫好八項評分。",
   "para": 401
  },
  {
   "id": "p4_s04",
   "narration": "兩個 AI 收到一模一樣的字，一個字都沒差。",
   "para": 401
  },
  {
   "id": "p4_s05",
   "narration": "結果舊的三點一版五分，新的三點五版只拿三分。",
   "para": 401
  },
  {
   "id": "p4_s06",
   "narration": "三點五版的交通少算十五元，剛好是公車那一筆。",
   "para": 401
  },
  {
   "id": "p4_s07",
   "narration": "不過筆數兩個都數錯，六格全錯。",
   "para": 401
  },
  {
   "id": "p4_s08",
   "narration": "不過只出一題、各問兩次，誰比較強，還不知道。",
   "para": 401
  },
  {
   "id": "p4_s09",
   "narration": "所以重要的數字，先算好答案，再讓 AI 算，自己對一次。",
   "para": 401
  },
  {
   "id": "p4_s10",
   "narration": "你平常用哪個？留言「對決」，拿這題的原題。",
   "para": 401
  },
  {
   "id": "p5_s01",
   "narration": "客服 AI 愛亂編？用三招，讓它老實說不知道。",
   "para": 501
  },
  {
   "id": "p5_s02",
   "narration": "我給它一份只有五行的早餐店資料，再問五件資料裡沒有的事。",
   "para": 501
  },
  {
   "id": "p5_s03",
   "narration": "什麼規定都不加，五題全編，連 Wi-Fi 都說成沒有。",
   "para": 501
  },
  {
   "id": "p5_s04",
   "narration": "第一招，只根據資料，編的剩兩題。",
   "para": 501
  },
  {
   "id": "p5_s05",
   "narration": "第二招，准許它說資料裡沒有寫。",
   "para": 501
  },
  {
   "id": "p5_s06",
   "narration": "結果五題全都老實說沒寫，一題都沒編。",
   "para": 501
  },
  {
   "id": "p5_s07",
   "narration": "第三招，先引用原文，沒用，五題還是都編。",
   "para": 501
  },
  {
   "id": "p5_s08",
   "narration": "不過我只試一份五行資料、一個模型，長文件還不知道。",
   "para": 501
  },
  {
   "id": "p5_s09",
   "narration": "所以最有用的是那句：資料沒寫，就說沒寫。",
   "para": 501
  },
  {
   "id": "p5_s10",
   "narration": "留言「不知道」，拿這三句規定的提示詞。",
   "para": 501
  },
  {
   "id": "p6_s01",
   "narration": "拍一張外文菜單，叫 AI 翻譯，只說翻譯，夠嗎？",
   "para": 601
  },
  {
   "id": "p6_s02",
   "narration": "第一種問法，只說：幫我翻譯這張菜單。",
   "para": 601
  },
  {
   "id": "p6_s03",
   "narration": "結果品名、價格、過敏提示都對，一道也沒錯。",
   "para": 601
  },
  {
   "id": "p6_s04",
   "narration": "可是親子丼，第二次它只留日文名，沒說是什麼。",
   "para": 601
  },
  {
   "id": "p6_s05",
   "narration": "第二種問法，請它說明做法、食材，標出過敏原。",
   "para": 601
  },
  {
   "id": "p6_s06",
   "narration": "每道菜都多了說明，像親子丼：雞肉洋蔥淋蛋，蓋在飯上。",
   "para": 601
  },
  {
   "id": "p6_s07",
   "narration": "但洋蔥、叉燒、蔥花，菜單根本沒印，是它補的，沒有一道標不確定。",
   "para": 601
  },
  {
   "id": "p6_s08",
   "narration": "不過我只用一張自製菜單、一個模型，真的店家的菜單，還不知道。",
   "para": 601
  },
  {
   "id": "p6_s09",
   "narration": "所以做法：拍清楚、要說明、過敏原一定問店家。",
   "para": 601
  },
  {
   "id": "p6_s10",
   "narration": "留言「菜單」，拿這句說清楚的提示詞。",
   "para": 601
  }
 ]
}