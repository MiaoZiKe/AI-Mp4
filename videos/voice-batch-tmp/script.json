{
 "slug": "voice-batch-tmp",
 "voice": {
  "voiceName": "Sulafat",
  "mode": "take",
  "languageCode": "cmn-TW",
  "profile": "ai-report-v5"
 },
 "scenes": [
  {
   "id": "p1_s01",
   "narration": "想要自己的記帳工具，不用寫一行程式，一句話就行。",
   "para": 101
  },
  {
   "id": "p1_s02",
   "narration": "我只說：輸入金額、選分類，算出本月總共花多少。",
   "para": 101
  },
  {
   "id": "p1_s03",
   "narration": "它交回一個網頁檔，一開始是空的。我記了四筆，本月總共四百九十五元。",
   "para": 101
  },
  {
   "id": "p1_s04",
   "narration": "重新整理，資料還在，存在這支手機的瀏覽器裡。",
   "para": 101
  },
  {
   "id": "p1_s05",
   "narration": "但有個小毛病：點一下刪，紀錄馬上不見，沒有確認。",
   "para": 101
  },
  {
   "id": "p1_s06",
   "narration": "我照實跟它說：刪除前先問我一次，其他地方不要動。",
   "para": 101
  },
  {
   "id": "p1_s07",
   "narration": "再試一次，按刪除先跳確認，按取消都還在，按確定才刪一筆。",
   "para": 101
  },
  {
   "id": "p1_s08",
   "narration": "不過我只試了一個模型和這一種工具，別的需求行不行，還不知道。",
   "para": 101
  },
  {
   "id": "p1_s09",
   "narration": "所以做法三步：講清楚、交給 AI、用手機試，有毛病就說。",
   "para": 101
  },
  {
   "id": "p1_s10",
   "narration": "留言「記帳」，拿這段提示詞。",
   "para": 101
  },
  {
   "id": "p2_s01",
   "narration": "要辦生日聚會，邀請網頁不用找人做，一句話就行。",
   "para": 201
  },
  {
   "id": "p2_s02",
   "narration": "我只說：要有時間地點、倒數天數，還有回覆按鈕。",
   "para": 201
  },
  {
   "id": "p2_s03",
   "narration": "它交回網頁，時間地點都有，倒數三十二天，我核對過，算對了。",
   "para": 201
  },
  {
   "id": "p2_s04",
   "narration": "點「我會去」，填名字送出，名單多一個人。",
   "para": 201
  },
  {
   "id": "p2_s05",
   "narration": "但有兩個毛病：名單有我沒輸入的人，回覆重新整理就不見。",
   "para": 201
  },
  {
   "id": "p2_s06",
   "narration": "我照實說：拿掉預填名單，回覆要存在手機裡。",
   "para": 201
  },
  {
   "id": "p2_s07",
   "narration": "再試一次，名單是空的，我送三個回覆，重新整理都還在。",
   "para": 201
  },
  {
   "id": "p2_s08",
   "narration": "不過回覆只存在這支手機，要收所有人的，這次沒做。",
   "para": 201
  },
  {
   "id": "p2_s09",
   "narration": "所以做法三步：講清楚、交給 AI、用手機點一遍，有毛病就說。",
   "para": 201
  },
  {
   "id": "p2_s10",
   "narration": "留言「邀請」，拿這段提示詞。",
   "para": 201
  },
  {
   "id": "p3_s01",
   "narration": "行程亂躺在備忘錄？丟給 AI，變成一頁能點的行程表。",
   "para": 301
  },
  {
   "id": "p3_s02",
   "narration": "我先貼上亂排的草稿，只有時間和地點。",
   "para": 301
  },
  {
   "id": "p3_s03",
   "narration": "然後說：做成手機行程頁，每一項能勾選，重新整理還記得。",
   "para": 301
  },
  {
   "id": "p3_s04",
   "narration": "它交回一頁：分兩天、時間軸，每項有時間、地點、怎麼去。",
   "para": 301
  },
  {
   "id": "p3_s05",
   "narration": "我用手機勾了三項，計數跟著變，重新整理，勾的還在。",
   "para": 301
  },
  {
   "id": "p3_s06",
   "narration": "但有個小毛病：一打開寫十一項，勾了卻變十二項。",
   "para": 301
  },
  {
   "id": "p3_s07",
   "narration": "我照實說：總數一打開就要對，其他不要動。",
   "para": 301
  },
  {
   "id": "p3_s08",
   "narration": "再試一次，一打開就寫十二項，勾三項，重新整理也對。",
   "para": 301
  },
  {
   "id": "p3_s09",
   "narration": "不過行程是我虛構的草稿，真的出門好不好用，還不知道。",
   "para": 301
  },
  {
   "id": "p3_s10",
   "narration": "所以做法三步：貼上行程、交給 AI、用手機點，有毛病就說。",
   "para": 301
  },
  {
   "id": "p3_s11",
   "narration": "留言「行程」，拿這段提示詞。",
   "para": 301
  },
  {
   "id": "p4_s01",
   "narration": "叫 AI 做咖啡店網頁，用手機寬度打開，價目表的價格欄不見了。",
   "para": 401
  },
  {
   "id": "p4_s02",
   "narration": "我請它做咖啡店網頁，有價目表和推薦卡，交回一個網頁檔。",
   "para": 401
  },
  {
   "id": "p4_s03",
   "narration": "手機寬度打開，價目表右邊被切掉，價格欄在畫面外。",
   "para": 401
  },
  {
   "id": "p4_s04",
   "narration": "我跟它說：價格欄被擠到畫面外，請修好，其他不要動。",
   "para": 401
  },
  {
   "id": "p4_s05",
   "narration": "它改了，但只是變成能左右滑，價格還是要滑才看得到。",
   "para": 401
  },
  {
   "id": "p4_s06",
   "narration": "所以一句話只修了一半，因為我沒說要不用滑。這次只測一個網頁。",
   "para": 401
  },
  {
   "id": "p4_s07",
   "narration": "我再補一句：不要橫向滑動，每個品項改成一張小卡片。",
   "para": 401
  },
  {
   "id": "p4_s08",
   "narration": "這次每個品項是一張卡片，尺寸、熱量、價格，不用滑就看得到。",
   "para": 401
  },
  {
   "id": "p4_s09",
   "narration": "所以做法三步：用手機寬度打開、說清楚要看到什麼、再打開確認。",
   "para": 401
  },
  {
   "id": "p4_s10",
   "narration": "留言「手機」，拿這句修版提示詞。",
   "para": 401
  },
  {
   "id": "p5_s01",
   "narration": "把 Excel 表格貼給 AI，約十一秒，就交回一個會動的圖表網頁。",
   "para": 501
  },
  {
   "id": "p5_s02",
   "narration": "我貼上從 Excel 複製的銷量表，請它畫折線圖，要有動畫。",
   "para": 501
  },
  {
   "id": "p5_s03",
   "narration": "網頁打開，三條線真的一條一條畫出來。",
   "para": 501
  },
  {
   "id": "p5_s04",
   "narration": "但是看三月，門市 B 的線掉到零。表格那格明明是空白。",
   "para": 501
  },
  {
   "id": "p5_s05",
   "narration": "空白，不等於零。這是 AI 自己的決定，我沒有交代。",
   "para": 501
  },
  {
   "id": "p5_s06",
   "narration": "我補一句：空白代表沒資料，別畫成零，線斷開，標上無資料。",
   "para": 501
  },
  {
   "id": "p5_s07",
   "narration": "改完，三月那一段斷開，標著無資料，其他兩條線沒動。",
   "para": 501
  },
  {
   "id": "p5_s08",
   "narration": "不過我只試了兩份小表格，兩個模型，更大的表格行不行，還不知道。",
   "para": 501
  },
  {
   "id": "p5_s09",
   "narration": "所以做法三步：貼表格、看圖有沒有怪點，有就說清楚。",
   "para": 501
  },
  {
   "id": "p5_s10",
   "narration": "留言「圖表」，拿這句貼表格的提示詞。",
   "para": 501
  },
  {
   "id": "p6_s01",
   "narration": "一份講義丟給 AI，約十秒，就變成能自己測驗的小考網頁。",
   "para": 601
  },
  {
   "id": "p6_s02",
   "narration": "我貼上虛構講義，請它出五題，選完有對錯，最後算分。",
   "para": 601
  },
  {
   "id": "p6_s03",
   "narration": "它交回網頁檔，一次一題，選完跳出對錯和解釋。",
   "para": 601
  },
  {
   "id": "p6_s04",
   "narration": "我逐題對過講義，五題都對得上。",
   "para": 601
  },
  {
   "id": "p6_s05",
   "narration": "但有個小毛病：選完後選項全變灰，看不出我選了哪個，哪個才對。",
   "para": 601
  },
  {
   "id": "p6_s06",
   "narration": "我說：答對標綠色，答錯標紅色，也把正確答案標綠。",
   "para": 601
  },
  {
   "id": "p6_s07",
   "narration": "改完，選錯的是紅色，正確答案是綠色，一眼就看懂。",
   "para": 601
  },
  {
   "id": "p6_s08",
   "narration": "我故意答錯第一題，其餘答對，總分八十分。",
   "para": 601
  },
  {
   "id": "p6_s09",
   "narration": "不過只試了這一份講義，更長的講義行不行，還不知道。",
   "para": 601
  },
  {
   "id": "p6_s10",
   "narration": "所以做法三步：貼講義、檢查題目、哪裡看不懂就說。",
   "para": 601
  },
  {
   "id": "p6_s11",
   "narration": "留言「小考」，拿這句出題提示詞。",
   "para": 601
  }
 ]
}