{
  "_meta": { "desc": "提問＋下一集：兩行大字問句、留言關鍵字、下一集預告卡（照片＋標題）", "cues": 4, "beat": "cta", "kw": ["headMark1", "headMark2"],
    "cueHint": "c1 問句前半關鍵詞｜c2 問句後半關鍵詞｜c3 下一集題目念出｜c4 留言關鍵字念出",
    "optional": "選填（2026/11/21，沒填就是原本的樣子）：nextAt／photoAt／titleAt／frameAt（結論卡提早出現、停久一點）、photoSteps（簡圖分段畫出的時間點陣列，每個點擦出下一段；有它就不用 photoEndAt）、photoStepP（每段畫到的比例 0–1）、photoDir（right｜down）、photoColor（true＝彩色資料圖，不蓋暗色）" },
  "props": {
    "panel": "ask",
    "head": { "lines": ["{{headLine1}}", "{{headLine2}}"], "marks": ["{{headMark1}}", "{{headMark2}}"], "at": "start-18", "markAts": ["c1+6", "c2+2"] },
    "cta": { "text": "留言「{{comment}}」拿完整資料", "at": "c4" },
    "next": {
      "label": "{{nextLabel|下一集}}", "at": "{{nextAt|c2+8}}",
      "photo": { "name": "{{photoName}}", "caption": "{{photoCaption|示意照片}}", "at": "{{photoAt|c2+12}}", "stepAts": "{{photoSteps?}}", "stepP": "{{photoStepP?}}", "dir": "{{photoDir?}}", "color": "{{photoColor?}}" },
      "title": "{{nextTitle}}", "titleAt": "{{titleAt|c3}}", "frameAt": "{{frameAt|c4+6}}"
    },
    "news": { "dateline": "{{dateline}}", "lt": "{{lt|提問}}", "place": "{{place?}}" }
  }
}
