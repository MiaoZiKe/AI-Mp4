      "headAt": "start-20", "at": "start-16", "bigAt": "{{leftBigAt|c4}}", "srcAt": "{{leftSrcAt|c4+8}}",
      "tag": { "kind": "{{leftKind|report}}", "text": "{{leftTag}}", "at": "{{leftTagAt|c4+14}}" }
    },
    "right": {
      "head": "{{rightHead}}", "big": "{{rightBig}}", "bigPx": "{{rightBigPx?}}", "src": "{{rightSrc}}", "count": "{{rightCount?}}",
      "headAt": "start-20", "at": "start-16", "bigAt": "{{rightBigAt|c3-4}}", "srcAt": "{{rightSrcAt|c3+6}}",
      "tag": { "kind": "{{rightKind|report}}", "text": "{{rightTag}}", "at": "{{rightTagAt|c3+10}}" },
      "masthead": { "name": "{{rightMast}}", "date": "{{rightMastDate}}", "at": "c2+4" }
    },
    "mid": { "text": "{{mid|？}}", "at": "c4+4" },
    "photo": { "name": "{{photoName?}}", "caption": "{{photoCaption?}}", "at": "start", "endAt": "{{photoEndAt|c4}}", "stepAts": "{{photoSteps?}}", "stepP": "{{photoStepP?}}", "dir": "{{photoDir?}}", "color": "{{photoColor?}}" },
    "news": { "dateline": "{{dateline}}", "lt": "{{lt|兩種說法}}", "place": "{{place?}}" }
